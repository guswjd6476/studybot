{
    "name": "studybot",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "description": "하루 꼭 해야 할 일정을 보내면 남는 시간에 공부 계획을 추천하는 텔레그램 봇",
    "scripts": {
        "build": "tsc",
        "start": "node dist/bot.js",
        "dev": "ts-node src/bot.ts",
        "typecheck": "tsc --noEmit",
        "test": "tsc && node --test \"dist/**/*.test.js\""
    },
    "engines": {
        "node": ">=22.9"
    },
    "dependencies": {
        "telegraf": "^4.16.3"
    },
    "devDependencies": {
        "@types/node": "^26.6.6",
        "typescript": "^7.0.2"
    }
}

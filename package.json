{
    "name": "studybot",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "description": "하루 꼭 해야 할 일정을 보내면 남는 시간에 공부 계획을 추천하는 텔레그램 봇",
    "scripts": {
        "start": "node --env-file-if-exists=.env --experimental-strip-types src/bot.ts",
        "test": "node --experimental-strip-types --test test/*.test.ts",
        "typecheck": "tsc --noEmit"
    },
    "engines": {
        "node": ">=22.9"
    },
    "dependencies": {
        "telegraf": "^4.16.3"
    },
    "devDependencies": {
        "@types/node": "^26.6.6",
        "typescript": "^7.0.2"
    }
}

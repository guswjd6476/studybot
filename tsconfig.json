{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "allowImportingTsExtensions": true,
        "rewriteRelativeImportExtensions": true,
        "outDir": "dist",
        "rootDir": ".",
        "strict": true,
        "skipLibCheck": true,
        "types": ["node"]
    },
    "include": ["src", "test"]
}
